# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Python
__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
dist/
build/

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code local settings (agents and commands ARE tracked)
.claude/settings.local.json

# Engagement data (client-confidential — never commit)
engagements/
# Ignore all direct children of Engagement/ except explicit exceptions below
Engagement/*
# Exceptions: non-client content that lives under Engagement/ (events, talks, internal)
!Engagement/events/

# Environment files (may contain secrets)
.env
.env.local
.env.*.local
.git_askpass.sh

# PII anonymization artifacts (contain real client names)
.pii_mapping.json
.anon_*

# Temporary files
*.tmp
/tmp/
interim_*.md

# OS-generated
Thumbs.db
Desktop.ini

# Miscellaneous
*.webloc

# Generated / transient artifacts (never commit — these inflate Source Control)
# git worktrees spun up by background agents
.claude/worktrees/
# generated knowledge graph (rebuilt from code)
graphify-out/
# generated deliverable scratch
/outputs/
# generated pricing output
deal-pricing-system/output/
# downloaded/packaged archives
*.zip
# superseded — retired skills now live in .claude/commands/deprecated/
legacy/

# Unpacked archives / scratch design kits (downloaded, not source)
circularize-design-system/
circularise-design-system/
claude-starter-kit/
skill-package/
uploads-for-claude-design/
frontline-2026-design-system/
frontline-2026-for-claude-design/
